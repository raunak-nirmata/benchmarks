# Exact profile used for the article published from the 2026-08-19 run.
# Versions and load shape are overridable for exploratory runs, but the
# comparison script will label a run as an exact article reproduction only
# when every value below matches.
KIND_VERSION=${KIND_VERSION:-v0.32.0}
KUBECTL_VERSION=${KUBECTL_VERSION:-v1.36.1}
HELM_VERSION=${HELM_VERSION:-v3.18.6}
REFERENCE_DOCKER_CLIENT_VERSION=${REFERENCE_DOCKER_CLIENT_VERSION:-29.1.3}
REFERENCE_DOCKER_SERVER_VERSION=${REFERENCE_DOCKER_SERVER_VERSION:-28.2.2}

KIND_NODE_IMAGE=${KIND_NODE_IMAGE:-kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5}
KYVERNO_CHART_VERSION=${KYVERNO_CHART_VERSION:-3.8.2}
KYVERNO_CHART_SHA256=${KYVERNO_CHART_SHA256:-f4fc787cf1d6781eefb9e9b45837edcddcfae984c872888289914e97207cc5de}
GATEKEEPER_CHART_VERSION=${GATEKEEPER_CHART_VERSION:-3.23.0}
GATEKEEPER_CHART_SHA256=${GATEKEEPER_CHART_SHA256:-33f018bca8b875a9e01f447efef09414609d0d38185101207a4a6d655fe3d2a0}

# Exactly 12,000 measured requests per engine/trial.
DURATION_SECONDS=${DURATION_SECONDS:-60}
TARGET_RPS=${TARGET_RPS:-200}
CONCURRENCY=${CONCURRENCY:-128}
REQUEST_TIMEOUT_SECONDS=${REQUEST_TIMEOUT_SECONDS:-30}

WARMUP_SECONDS=${WARMUP_SECONDS:-15}
WARMUP_RPS=${WARMUP_RPS:-50}
IDLE_SAMPLE_SECONDS=${IDLE_SAMPLE_SECONDS:-15}
SETTLE_SECONDS=${SETTLE_SECONDS:-15}
SAMPLE_INTERVAL_SECONDS=${SAMPLE_INTERVAL_SECONDS:-1}
VERIFY_ITERATIONS=${VERIFY_ITERATIONS:-20}
# The historical host reported two running Docker containers during each cell,
# but did not capture their identities. Set this to true for a stricter new run.
REQUIRE_EXCLUSIVE_DOCKER=${REQUIRE_EXCLUSIVE_DOCKER:-false}

TRIALS=${TRIALS:-3}
ENGINES=${ENGINES:-"baseline kyverno gatekeeper native"}
