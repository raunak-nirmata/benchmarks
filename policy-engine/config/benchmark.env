# Exact profile used for the article published from the 2026-08-19 run.
# Versions and load shape are overridable for exploratory runs, but the
# comparison script will label a run as an exact article reproduction only
# when every value below matches.
KIND_VERSION=${KIND_VERSION:-v0.32.0}
KUBECTL_VERSION=${KUBECTL_VERSION:-v1.36.1}
HELM_VERSION=${HELM_VERSION:-v3.18.6}
REFERENCE_DOCKER_CLIENT_VERSION=${REFERENCE_DOCKER_CLIENT_VERSION:-29.1.3}
REFERENCE_DOCKER_SERVER_VERSION=${REFERENCE_DOCKER_SERVER_VERSION:-28.2.2}

KIND_NODE_IMAGE=${KIND_NODE_IMAGE:-kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5}
KYVERNO_CHART_VERSION=${KYVERNO_CHART_VERSION:-3.8.2}
KYVERNO_CHART_SHA256=${KYVERNO_CHART_SHA256:-f4fc787cf1d6781eefb9e9b45837edcddcfae984c872888289914e97207cc5de}
GATEKEEPER_CHART_VERSION=${GATEKEEPER_CHART_VERSION:-3.23.0}
GATEKEEPER_CHART_SHA256=${GATEKEEPER_CHART_SHA256:-33f018bca8b875a9e01f447efef09414609d0d38185101207a4a6d655fe3d2a0}

# Exactly 12,000 measured requests per engine/trial.
DURATION_SECONDS=${DURATION_SECONDS:-60}
TARGET_RPS=${TARGET_RPS:-200}
CONCURRENCY=${CONCURRENCY:-128}
REQUEST_TIMEOUT_SECONDS=${REQUEST_TIMEOUT_SECONDS:-30}

WARMUP_SECONDS=${WARMUP_SECONDS:-15}
WARMUP_RPS=${WARMUP_RPS:-50}
IDLE_SAMPLE_SECONDS=${IDLE_SAMPLE_SECONDS:-15}
SETTLE_SECONDS=${SETTLE_SECONDS:-15}
SAMPLE_INTERVAL_SECONDS=${SAMPLE_INTERVAL_SECONDS:-1}
VERIFY_ITERATIONS=${VERIFY_ITERATIONS:-20}
# The historical host reported two running Docker containers during each cell,
# but did not capture their identities. Set this to true for a stricter new run.
REQUIRE_EXCLUSIVE_DOCKER=${REQUIRE_EXCLUSIVE_DOCKER:-false}

TRIALS=${TRIALS:-3}
# The four engines the article published. The kyverno-cel arm is deliberately
# not here: a no-argument run must reproduce the published profile, so any
# extra arm is opt-in via a preset (see config/presets/).
ENGINES=${ENGINES:-"baseline kyverno gatekeeper native"}

# --- Scaling axis and local-build overrides (not part of the published profile) ---
# POLICY_COUNT is how many identical copies of the contract policy pair each
# engine installs. 1 renders the templates verbatim and reproduces the published
# profile; any higher value renders N suffixed copies per arm and marks the run
# as not an article reproduction.
POLICY_COUNT=${POLICY_COUNT:-1}
# Bytes of inert annotation added to every Pod the client sends, which is how the
# admitted object grows. 0 keeps the published payload (a ~320-byte Pod). Costs an
# engine pays per policy for re-reading the admitted object scale with this, so a
# policy-count sweep at the default size cannot see them.
PAYLOAD_PADDING_BYTES=${PAYLOAD_PADDING_BYTES:-0}
# Which policy set the kyverno-cel arm installs. "matchconditions" is the
# published set. "selectors" expresses the same contract through matchConstraints
# selectors, which keeps Kyverno from giving each policy its own webhook endpoint,
# so one AdmissionReview carries every policy instead of one each. Only the
# selectors variant exercises the engine's per-request policy loop.
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-matchconditions}
# Shape of the Pod the client sends. "minimal" is the published one-container Pod,
# about 300 bytes serialized. "realistic" is the shape a Deployment produces for an
# ordinary service - two containers, resources, probes, a restricted security
# context, service-account and config mounts - and comes out near 3.8 KB. The
# report states the measured size either way.
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
# Which halves of the contract every arm installs. "both" is the published shape.
# "validate" is the controlled shape for comparing engines or builds: the two
# kyverno-cel variants install the same validating work either way, while their
# mutating work differs, because the matchConditions variant skips a patch whose
# annotation is already present and mutating webhooks run in sequence over the
# patched object. A validate-only run removes that asymmetry.
POLICY_MODE=${POLICY_MODE:-both}
# PROFILE=exact requires the four published engines exactly once. PROFILE=scaling
# allows any subset that still contains baseline, for A/B work on one engine.
PROFILE=${PROFILE:-exact}
# A local Kyverno chart directory, for measuring builds that have no published
# chart. Setting it drops the pinned-chart provenance gate.
KYVERNO_CHART_PATH=${KYVERNO_CHART_PATH:-}
# Image overrides for a locally built Kyverno loaded into the kind node. Leave
# empty to use whatever the chart pins. Tag both the controller and the init
# image to deterministic names before loading them; ko's generated names are not
# predictable. Pull policy defaults to IfNotPresent whenever a registry or tag is
# overridden, because a kind-loaded image cannot be pulled.
KYVERNO_IMAGE_REGISTRY=${KYVERNO_IMAGE_REGISTRY:-}
KYVERNO_IMAGE_REPOSITORY=${KYVERNO_IMAGE_REPOSITORY:-}
KYVERNO_IMAGE_TAG=${KYVERNO_IMAGE_TAG:-}
KYVERNO_INIT_IMAGE_REPOSITORY=${KYVERNO_INIT_IMAGE_REPOSITORY:-}
KYVERNO_INIT_IMAGE_TAG=${KYVERNO_INIT_IMAGE_TAG:-}
