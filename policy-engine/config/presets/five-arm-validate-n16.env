# Cross-engine comparison at 16 policies, validating half only.
#
# The controlled shape. With POLICY_MODE=both the two kyverno-cel variants do not
# perform the same mutating work: the matchConditions variant skips a patch whose
# annotation is already present, and mutating webhooks run in sequence over the
# progressively patched object, so only the first copy executes. Measured on a
# 16-policy run, that is 12,850 mutating executions against 206,560.
#
# The validating half has no such condition and executes every copy in both
# variants - 206,560 either way - so a validate-only run compares identical work
# done as one call of 16 against 16 calls of one.
ENGINES=${ENGINES:-"baseline kyverno kyverno-cel gatekeeper native"}
POLICY_COUNT=${POLICY_COUNT:-16}
POLICY_MODE=${POLICY_MODE:-validate}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-selectors}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
TARGET_RPS=${TARGET_RPS:-200}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
