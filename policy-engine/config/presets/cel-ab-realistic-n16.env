# A/B of two kyverno-cel builds against a Pod of the shape a Deployment produces.
#
# Object conversion cost tracks the number of JSON nodes, not the byte count: a
# flat multi-KB annotation string adds bytes and almost no allocations, while a
# two-container Pod with env, ports, probes and volume mounts adds many. The
# realistic profile is therefore a better stress of per-policy object handling
# than PAYLOAD_PADDING_BYTES at any size.
#
# 150 requests/s rather than 200: the larger object costs more per request and
# the engine arm approaches saturation at 200 on a four-core host.
ENGINES=${ENGINES:-"baseline kyverno-cel"}
POLICY_COUNT=${POLICY_COUNT:-16}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-selectors}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-realistic}
TARGET_RPS=${TARGET_RPS:-150}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
