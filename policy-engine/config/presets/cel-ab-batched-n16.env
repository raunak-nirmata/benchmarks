# A/B of two kyverno-cel builds where one webhook call carries all 16 policies.
#
# Same 32 policy objects as cel-ab-fanout-n16 and the same contract, expressed
# through matchConstraints selectors instead of matchConditions. That keeps the
# policies in one shared webhook, so the engine's per-request policy loop runs 16
# times per call - the only shape where per-policy work can be measured.
ENGINES=${ENGINES:-"baseline kyverno-cel"}
POLICY_COUNT=${POLICY_COUNT:-16}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-selectors}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
TARGET_RPS=${TARGET_RPS:-200}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
