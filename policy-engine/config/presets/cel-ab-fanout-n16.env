# A/B of two kyverno-cel builds where each policy gets its own webhook endpoint.
#
# matchConditions makes a CEL policy fine-grained (see buildWebhookRules in
# pkg/controllers/webhook/validating.go), so 16 policies produce 16 calls each
# carrying one policy. Any optimization to the engine's per-request policy loop
# is invisible here, because that loop runs once per call.
#
# Keep this preset as the control for cel-ab-batched-n16.
ENGINES=${ENGINES:-"baseline kyverno-cel"}
POLICY_COUNT=${POLICY_COUNT:-16}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-matchconditions}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
TARGET_RPS=${TARGET_RPS:-200}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
