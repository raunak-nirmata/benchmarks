# A/B of two kyverno-cel builds, validating half only, batched.
#
# The cleanest measurement of the request-map hoist: the validating engine loop
# runs 16 times per call, every policy executes, and no mutating work is present
# to vary between variants or between builds.
#
# Pair it with KYVERNO_CEL_VARIANT=matchconditions as the control, where the same
# 16 policies arrive as 16 calls carrying one policy each and the loop the hoist
# optimizes runs exactly once.
ENGINES=${ENGINES:-"baseline kyverno-cel"}
POLICY_COUNT=${POLICY_COUNT:-16}
POLICY_MODE=${POLICY_MODE:-validate}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-selectors}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
TARGET_RPS=${TARGET_RPS:-200}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
