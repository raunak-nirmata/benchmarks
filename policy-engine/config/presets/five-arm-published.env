# Cross-engine comparison at the published policy shape.
#
# This is the article's own load profile with two differences: the kyverno-cel
# arm is included (the article predates it), and PROFILE=scaling allows that
# fifth arm. Use it to place an engine against baseline, Gatekeeper, and native
# admission policies on a typical single-policy admission path.
#
# One policy pair per arm means each engine call carries exactly one policy, so
# this shape cannot observe any cost that scales with policy count.
ENGINES=${ENGINES:-"baseline kyverno kyverno-cel gatekeeper native"}
POLICY_COUNT=${POLICY_COUNT:-1}
KYVERNO_CEL_VARIANT=${KYVERNO_CEL_VARIANT:-matchconditions}
PAYLOAD_PROFILE=${PAYLOAD_PROFILE:-minimal}
TARGET_RPS=${TARGET_RPS:-200}
TRIALS=${TRIALS:-3}
PROFILE=${PROFILE:-scaling}
